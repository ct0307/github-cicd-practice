{
  "name": "cicd-labs-1-3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "node --test test/static.test.mjs && npm test --workspaces",
    "build": "node scripts/check-static.mjs && npm run build --workspaces",
    "dev:backend": "npm run dev --workspace @cicd/backend",
    "dev:frontend": "npm run dev --workspace @cicd/frontend",
    "check:static": "node scripts/check-static.mjs missing-static"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
